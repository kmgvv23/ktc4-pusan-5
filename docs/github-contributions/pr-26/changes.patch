         self.parse_error = parse_error
 
@@ -91,8 +145,9 @@ def _failed(run_id: str | None, raw_json: dict[str, Any], reason: str) -> Parsed
 def parse_report_file(path: Path) -> ParsedReport:
     """래퍼 파일 하나를 연다. 어떤 입력이 와도 예외를 던지지 않는다.
 
