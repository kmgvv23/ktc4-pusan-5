+# '로 하이브를' 같은 문장 조각이 종목명 자리에 들어간다(실제로 3건 나왔다).
+_PICK_LEAD = re.compile(r"^(?:로|으로|는|은|이|가|를|을|에|와|과|및|기존|기준)\s*")
+_PICK_TAIL = re.compile(r"(?:를|을|는|은|이|가|와|과|이며|이고|입니다|이다)$")
+_NOT_A_PICK = {
+    "유지", "및", "관심종목", "차선호주", "제시", "상향", "하향", "기타",
+    "자동차", "2차전지", "top", "picks", "pick",
