+    r"(Overweight|OVERWEIGHT|비중\s?확대|Neutral|NEUTRAL|중\s?립"
+    r"|Underweight|UNDERWEIGHT|비중\s?축소|Positive|긍정적|Negative|부정적)"
+)
+_SECTOR_RATING_LABEL = re.compile(
+    r"(?:(?:업종|산업|투자)?\s*(?:의견|등급|판단)|업종|산업)"
+    r"\s*[:：]?\s*[\"'‘“(（\[]?\s*$"
