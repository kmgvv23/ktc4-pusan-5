+              onFocus={() => setOpen(true)}
+              onBlur={() => setTimeout(() => setOpen(false), 150)}
+              placeholder="종목 · 개념 · 용어 검색"
+              aria-label="종목 또는 개념 검색"
+              aria-describedby="home-search-note"
